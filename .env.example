# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Only used by the overdue cron route (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this app (used in email links and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (https://resend.com). Without a key, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=Tasklane <notifications@your-domain.com>

# Protects /api/cron/overdue (Vercel Cron sends it as a Bearer token)
CRON_SECRET=change-me
